# Copy this file to .env.local (gitignored).
# Prisma CLI scripts load .env.local via dotenv-cli.

# Docker Compose default (see docker-compose.yml)
DATABASE_URL="postgresql://nexo:nexo@localhost:5432/nexo?schema=public"

# Auth.js (Iteration 2). Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Shared password for seed users (Iteration 2+). Change locally if you like.
TEST_USER_PASSWORD="Password123!"
